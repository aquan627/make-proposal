{
  "name": "rfp-analyzer",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "security:scan": "node scripts/security-scan.mjs",
    "check": "npm run typecheck && npm test && npm run security:scan && npm audit --omit=dev --audit-level=high && npm run build",
    "trace": "node scripts/trace.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "exceljs": "^4.4.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.4"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  }
}
